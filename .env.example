# ── Nambiraj Law Dynasty — website configuration ──────────────────────
# Copy to .env.local and fill in. Nothing here is required to render the
# site; only the contact form needs mail credentials to actually deliver.

# ── Email (contact form) ──────────────────────────────────────────────
# The /contact form posts to /api/contact, which sends the enquiry over
# SMTP. Without SMTP_USER and SMTP_PASS the endpoint reports itself as
# unconfigured and the form falls back to opening the visitor's own mail
# client, so enquiries are never silently lost.
#
# ⚠️ GMAIL: Google stopped accepting ordinary account passwords over SMTP
# in 2022. SMTP_PASS must be a 16-character APP PASSWORD (Google Account →
# Security → 2-Step Verification → App passwords), not the password you
# type into the Gmail web login. With the account password instead, Gmail
# answers `535-5.7.8 Username and Password not accepted`.
#
# Using the office's own mail server instead? Set SMTP_HOST to its
# hostname, SMTP_PORT to 465 (or 587 with SMTP_SECURE=false), and use a
# real mailbox's credentials — no app password needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nambiraj Law Dynasty <nambirajlawdynasty@gmail.com>

# Where the contact form delivers. Comma-separated; falls back to the
# chambers inbox if unset.
CONTACT_RECIPIENTS=nambirajlawdynasty@gmail.com

# ── Rate limiting (optional) ──────────────────────────────────────────
# Throttles the public contact endpoint to 5 submissions per hour per IP
# so it cannot be used as a mail relay. Without these the limiter is a
# no-op and the form still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
