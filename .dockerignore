# Keep the build context small and — critically — keep secrets out of
# the image. The real env files never get copied in; the app reads them
# at runtime via docker-compose env_file instead.
.git
.gitignore
node_modules
.next
out
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets — never bake these into an image layer.
.env
.env.local
.env.production
.env.*.local

# Editor / OS noise
.vscode
.idea
.DS_Store

# Deployment artifacts that don't belong inside the app image
Dockerfile
.dockerignore
docker-compose.yml
DEPLOYMENT.md
backups
